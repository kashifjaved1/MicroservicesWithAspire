{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "api1-route": {
        "ClusterId": "api1-cluster",
        "Match": {
          "Path": "/api1/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api1" },
          {
            "RequestHeader": "x-api-version",
            "Set": "1.0"
          }
        ]
      },
      "api2-route": {
        "ClusterId": "api2-cluster",
        "Match": {
          "Path": "/api2/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api2" },
          {
            "RequestHeader": "x-api-version",
            "Set": "1.0"
          }
        ]
      },
      "api3-route": {
        "ClusterId": "api3-cluster",
        "Match": {
          "Path": "/api3/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api3" },
          {
            "RequestHeader": "x-api-version",
            "Set": "1.0"
          }
        ]
      },
      "api4-route": {
        "ClusterId": "api4-cluster",
        "Match": {
          "Path": "/api4/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/api4" },
          {
            "RequestHeader": "x-api-version",
            "Set": "1.0"
          }
        ]
      }
    },
    "Clusters": {
      "api1-cluster": {
        "Destinations": {
          "api1-destination": {
            "Address": "https://restaurantsapi"
          }
        }
      },
      "api2-cluster": {
        "Destinations": {
          "api2-destination": {
            "Address": "https://authapi"
          }
        }
      },
      "api3-cluster": {
        "Destinations": {
          "api2-destination": {
            "Address": "https://storeapi"
          }
        }
      },
      "api4-cluster": {
        "Destinations": {
          "api2-destination": {
            "Address": "https://urlshortenerapi"
          }
        }
      }
    }
  }
}
